# --- ApplyMate monorepo env (copy to `.env` at repo root) ---
#
# SINGLE SOURCE OF TRUTH: edit only repo-root `.env` for web auth + API URL.
# `npm run dev` auto-syncs into `packages/web/.env.local` (gitignored).
# Do NOT duplicate GOOGLE_* / NEXTAUTH_* in packages/web/.env.
#
# Optional: repo-root `.env.local` for personal overrides (PostHog, etc.) — no empty keys.
# Extension-only vars: `packages/extension/.env`
#
# API backend (Nest). Local default — port 3000.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/
# Optional: tunnel local Nest for Vercel UI testing (see docs/vercel-ngrok-testing.md)
# NEXT_PUBLIC_API_URL=https://YOUR-SUBDOMAIN.ngrok-free.dev/api/
# NEXT_PUBLIC_USE_NGROK_TUNNEL=true
#
# NextAuth — THIS Next.js app URL (NOT the API). Dev runs Next on :3001.
# Bare origin is OK — dev sync normalizes to http://localhost:3001/api/auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001
# Google OAuth (NextAuth) — same Web client ID must be on Nest (`GOOGLE_CLIENT_ID`)
# See docs/backend-handoff-google-auth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — client DSN + release (production / staging)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=applymate-web@dev
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=  # CI secret for source map upload

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extension
EXTENSION_API_URL=http://localhost:3000/api/

# Playwright E2E (optional)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# E2E_LOGIN_EMAIL=
# E2E_LOGIN_PASSWORD=
