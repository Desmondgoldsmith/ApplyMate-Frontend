# --- Shared template (safe to commit) ---
# Copy to `.env` at the repo root and to package folders as needed:
#   .env
#   packages/web/.env
#   packages/extension/.env

# Web (Next.js) — copy to repo root `.env`. On `npm run dev`, auth vars are synced to
# `packages/web/.env.local` (gitignored) because Next.js only loads env from `packages/web/`.
#
# API backend (Nest). Usually port 3000 when running locally.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/
# Vercel UI + local API via ngrok (testing only): use ngrok URL + set true, then redeploy.
# NEXT_PUBLIC_USE_NGROK_TUNNEL=true
#
# NextAuth — URL of THIS Next.js app (NOT the API). If the API uses :3000, run Next on :3001.
# Bare origin is OK in root .env — dev sync normalizes to /api/auth for OAuth callbacks.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001
# Google OAuth (NextAuth) — see docs/backend-handoff-google-auth.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — client DSN + release (production / staging)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=applymate-web@dev
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=  # CI secret for source map upload

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extension
EXTENSION_API_URL=http://localhost:3000/api/

# Playwright E2E (optional)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# E2E_LOGIN_EMAIL=
# E2E_LOGIN_PASSWORD=
