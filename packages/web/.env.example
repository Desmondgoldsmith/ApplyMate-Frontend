# Copy to packages/web/.env (or .env.local). Sync with repo root `.env` web section.

NEXT_PUBLIC_API_URL=http://localhost:3000/api/
# Chrome extension ID from chrome://extensions (Developer mode) — enables proactive token handoff
NEXT_PUBLIC_EXTENSION_ID=
NEXTAUTH_SECRET=
# Next.js app URL (NOT the Nest API). Dev runs Next on :3001 — must match Google redirect URI.
# Sync script writes http://localhost:3001/api/auth when root .env has bare :3001
NEXTAUTH_URL=http://localhost:3001/api/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (omit locally to disable error reporting)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1
# Server/build-only (set in CI + production host)
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=applymate-web@dev
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=  # CI secret — uploads source maps on `next build`

NEXT_PUBLIC_SITE_URL=http://localhost:3001
# NEXT_PUBLIC_VALIDATE_HUMAN_COPY=
