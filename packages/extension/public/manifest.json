{
  "manifest_version": 3,
  "name": "ApplyMate",
  "version": "0.1.0",
  "description": "ApplyMate browser extension (development scaffold).",
  "permissions": ["storage", "sidePanel", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ApplyMate",
    "default_popup": "ui/popup.html"
  },
  "side_panel": {
    "default_path": "ui/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
