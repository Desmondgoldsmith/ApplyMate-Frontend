{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "eslint.config.mjs",
    "packages/web/**/*.ts",
    "packages/web/**/*.tsx",
    "packages/extension/**/*.ts",
    "packages/extension/**/*.tsx",
    "packages/extension/**/*.js",
    "packages/extension/scripts/**/*.mjs",
    "shared/**/*.ts",
    "shared/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/.next", "**/dist", "**/out", "**/build"]
}
